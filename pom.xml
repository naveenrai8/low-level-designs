<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Aggregator for the LLD guide.
      - Every numbered topic that ships code is a framework-free module (Java 21 + JUnit only).
      - `app/` is the ONLY module allowed to depend on Spring Boot; it wraps core modules in REST adapters.
      - The pre-rework Spring Boot code lives untouched in `_legacy-app/` and is NOT part of this reactor.
    -->
    <groupId>com.lld</groupId>
    <artifactId>lld-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>LLD Interview Guide (parent)</name>

    <modules>
        <!-- Phase 1: foundations with runnable bug/fix demos -->
        <module>07-concurrency-primitives</module>
        <module>08-multi-object-atomicity</module>
        <module>10-time-and-testability</module>
        <module>12-common-mistakes</module>
        <!-- Phase 3: concurrency-heavy components -->
        <module>21-rate-limiter</module>
        <!-- The single Spring Boot app (adapters over core modules) -->
        <module>app</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Kept aligned with what spring-boot-dependencies 4.1.1 manages, so core and app agree. -->
        <junit-jupiter.version>6.0.3</junit-jupiter.version>
        <spring-boot.version>4.1.1</spring-boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit-jupiter.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Every module gets JUnit Jupiter for tests; nothing else is inherited. -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.15.0</version>
                    <configuration>
                        <!-- Keep parameter names: Spring binds unnamed @PathVariable/@RequestParam by name.
                             spring-boot-starter-parent sets this; we don't use that parent, so we must. -->
                        <parameters>true</parameters>
                        <compilerArgs>
                            <arg>-Xlint:all</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.6</version>
                    <configuration>
                        <!-- Assertions on: invariant checks (assert) fire during tests. -->
                        <argLine>-ea</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
