<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Aggregator for the LLD guide.
      - Every numbered topic that ships code is a framework-free module (Java 21 + JUnit only).
      - `app/` is the ONLY module allowed to depend on Spring Boot; it wraps core modules in REST adapters.
      - The pre-rework Spring Boot code lives untouched in `_legacy-app/` and is NOT part of this reactor.
    -->
    <groupId>com.lld</groupId>
    <artifactId>lld-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>LLD Interview Guide (parent)</name>

    <modules>
        <!-- Phase 1: foundations with runnable bug/fix demos -->
        <module>07-concurrency-primitives</module>
        <module>08-multi-object-atomicity</module>
        <module>10-time-and-testability</module>
        <module>12-common-mistakes</module>
        <!-- Phase 2: classic LLD -->
        <module>14-parking-lot</module>
        <module>15-vending-machine</module>
        <module>16-elevator</module>
        <module>17-lru-lfu-cache</module>
        <module>18-logging-framework</module>
        <module>19-turn-based-game-engine</module>
        <module>20-library-management</module>
        <!-- Phase 3: concurrency-heavy components -->
        <module>21-rate-limiter</module>
        <module>22-blocking-queue-thread-pool</module>
        <module>23-delayed-job-scheduler</module>
        <module>24-kv-store-ttl-transactions</module>
        <module>25-pub-sub</module>
        <module>26-connection-pool</module>
        <module>27-circuit-breaker-and-retry</module>
        <module>28-id-generator</module>
        <module>29-consistent-hashing</module>
        <module>30-sliding-window-metrics</module>
        <!-- Phase 4: transactional domain problems -->
        <module>31-seat-hold-booking</module>
        <module>32-double-entry-ledger</module>
        <module>33-splitwise</module>
        <module>34-auction</module>
        <module>35-order-matching-engine</module>
        <module>36-ride-delivery-dispatch</module>

        <!-- Phase 5: design + algorithm hybrids -->
        <module>37-spreadsheet</module>
        <module>38-in-memory-file-system</module>
        <module>39-undo-redo-editor</module>
        <module>40-autocomplete-top-k</module>
        <module>41-leaderboard</module>
        <module>42-workflow-engine</module>
        <module>43-feature-flags</module>
        <module>44-notification-service</module>
        <module>45-content-popularity</module>
        <!-- Phase 6: capstones (glue over earlier modules) -->
        <module>46-capstone-api-gateway-core</module>
        <module>47-capstone-ticketing-platform</module>
        <module>48-capstone-jira-lite</module>

        <!-- The single Spring Boot app (adapters over core modules) -->
        <module>app</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Kept aligned with what spring-boot-dependencies 4.1.1 manages, so core and app agree. -->
        <junit-jupiter.version>6.0.3</junit-jupiter.version>
        <spring-boot.version>4.1.1</spring-boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit-jupiter.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Every module gets JUnit Jupiter for tests; nothing else is inherited. -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.15.0</version>
                    <configuration>
                        <!-- Keep parameter names: Spring binds unnamed @PathVariable/@RequestParam by name.
                             spring-boot-starter-parent sets this; we don't use that parent, so we must. -->
                        <parameters>true</parameters>
                        <compilerArgs>
                            <arg>-Xlint:all</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.6</version>
                    <configuration>
                        <!-- Assertions on: invariant checks (assert) fire during tests. -->
                        <argLine>-ea</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
